# Copier ce fichier en .env pour surcharger la configuration par défaut.
# Aucune valeur sensible ne doit être committée dans .env.

# Environnement : development | test | production
STOCKMANAGER_ENV=development

# Chemin complet du fichier de base SQLite.
# Si absent, un chemin par défaut est calculé selon le système d'exploitation.
# STOCKMANAGER_DB_PATH=/chemin/vers/stockmanager.db

# Niveau de log : DEBUG | INFO | WARNING | ERROR
STOCKMANAGER_LOG_LEVEL=INFO

# Devise par défaut (modifiable ensuite via les paramètres applicatifs en base)
STOCKMANAGER_DEFAULT_CURRENCY=XOF
